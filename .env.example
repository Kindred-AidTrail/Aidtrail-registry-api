# ==============================================================================
# AidTrail Registry API - Environment Configuration
# ==============================================================================

# Node Environment & Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aidtrail_registry?schema=public"

# Stellar Network & Soroban Configuration
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
HORIZON_URL="https://horizon-testnet.stellar.org"
CONTRACT_ID="CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM"

# Server Keypair for SEP-10 Authentication & Admin Transactions
# (Testnet deployer secret key - S...)
SERVER_SIGNING_KEY="SBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
SERVER_HOME_DOMAIN="api.aidtrail.kindred.org"

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-minimum-32-chars-long-development"
JWT_EXPIRES_IN="24h"

# PII Field Encryption (32-byte hex string = 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# S3 / MinIO Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET_NAME="aidtrail-documents"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE=true

# Indexer Configuration
INDEXER_POLL_INTERVAL_MS=3000
INDEXER_START_LEDGER=0
INDEXER_BATCH_SIZE=50

# Webhook Dispatch
WEBHOOK_MAX_RETRIES=5
WEBHOOK_TIMEOUT_MS=5000
